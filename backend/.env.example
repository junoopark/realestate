# 쉼표로 구분, 끝에 / 붙이지 않는다. localhost와 127.0.0.1은 서로 다른 출처다.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# 미설정 시 backend/local.db (SQLite). Supabase 연결 시 Session pooler URL로 변경 후 재시작.
# 비밀번호의 @, /, # 등은 URL 인코딩. 연결 문자열은 서버에만 저장한다.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@HOST.pooler.supabase.com:5432/postgres
DATABASE_URL=

# POST /policies/refresh · POST /indicators/refresh 공용 관리자 토큰. 미설정이면 수집 API 비활성화.
# 프론트엔드 JS/HTML 또는 GitHub에 실제 토큰을 넣지 않는다. CLI 수집은 토큰 불필요.
POLICY_ADMIN_TOKEN=

# ── 공공 통계 Open API 인증키 (GET /indicators/*, scripts/collect_indicators.py, scripts/collect_rone.py) ──
# 서버 환경변수·GitHub Actions secret 에만 저장한다.
# RONE_API_KEY  발급: https://www.reb.or.kr/r-one/portal/openapi/openApiIntroPage.do (한국부동산원 R-ONE > Open API > 인증키 신청)
# ECOS_API_KEY  발급: https://ecos.bok.or.kr/ > OpenAPI > 인증키 신청
# KOSIS_API_KEY 발급: https://kosis.kr/openapi/ > 활용신청 (2차 연동 변수용, 비워 둬도 된다)
RONE_API_KEY=
ECOS_API_KEY=
KOSIS_API_KEY=

# 지표 자료를 '오래됐다'고 보는 기준(시간). 이 시간 안에 받은 변수는 수집을 건너뛴다. 월 단위 통계라 24면 충분하다.
INDICATOR_REFRESH_HOURS=24
