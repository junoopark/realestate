# 쉼표로 구분, 끝에 / 붙이지 않는다. localhost와 127.0.0.1은 서로 다른 출처다.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# 미설정 시 backend/local.db (SQLite). Supabase 연결 시 Session pooler URL로 변경 후 재시작.
# 비밀번호의 @, /, # 등은 URL 인코딩. 연결 문자열은 서버에만 저장한다.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@HOST.pooler.supabase.com:5432/postgres
DATABASE_URL=

# POST /policies/refresh 전용 관리자 토큰. 미설정이면 수집 API 비활성화.
# 프론트엔드 JS/HTML 또는 GitHub에 실제 토큰을 넣지 않는다. CLI 수집은 토큰 불필요.
POLICY_ADMIN_TOKEN=

# 지표 데이터 (GET /indicators/{key})
# ECOS_API_KEY 발급: https://ecos.bok.or.kr/ > OpenAPI > 인증키 신청
# FRED_API_KEY 발급: https://fred.stlouisfed.org/docs/api/api_key.html
ECOS_API_KEY=
FRED_API_KEY=
